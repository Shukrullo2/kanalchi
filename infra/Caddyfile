# Let's Encrypt needs no contact address; renewals are automatic. (An empty `email` line
# is a parse error, so none is set.)
{
	on_demand_tls {
		ask http://api:8000/internal/tls/ask
	}
	# Requests that come through Cloudflare's proxy (orange-cloud records) or through a
	# forwarding droplet carry the reader's address in a header; trust only those senders,
	# so rate limits and the chat quota see readers rather than a handful of proxies.
	# Cloudflare's published ranges: https://www.cloudflare.com/ips/
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 {$TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Shared by the admin panel and every tenant domain.
(app) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		# Studio uploads are capped at 50 MB by the API; stop anything larger at the edge.
		request_body {
			max_size 64MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
			# The tenant is resolved from Host; this header is only ever set by the Next.js server.
			header_up -X-Tenant-Host
		}
	}
	handle /tg/* {
		reverse_proxy api:8000
	}
	# Post media (public bucket) and studio uploads (private bucket, presigned URLs).
	# The Host header is rewritten to the internal endpoint so presigned signatures verify.
	handle /media/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}
	handle /uploads/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

# Central admin panel: a normal certificate for a known name.
{$ADMIN_HOST} {
	import app
}

# Every tenant domain: the certificate is issued on demand once the ask endpoint approves it
# (a registered, verified channel domain, its www. alias, or <slug>.PLATFORM_DOMAIN).
https:// {
	tls {
		on_demand
	}
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent
	import app
}

# Plain HTTP on tenant domains only redirects; ACME challenges are handled by Caddy before this.
http:// {
	redir https://{host}{uri} permanent
}
