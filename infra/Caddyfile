{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/internal/tls/ask
	}
}

# Central admin panel
{$ADMIN_HOST} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

# Every tenant domain (certificate issued on demand after the ask endpoint approves it)
https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /tg/* {
		reverse_proxy api:8000
	}
	handle_path /media/* {
		rewrite * /media{path}
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
