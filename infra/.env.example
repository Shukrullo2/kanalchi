# ---- Domains ----
ADMIN_HOST=admin.example.com          # central admin panel host
PUBLIC_IP=203.0.113.10                # VPS public IP (tenant DNS must point here)
ACME_EMAIL=ops@example.com

# ---- App secrets (generate: `make gen-keys`) ----
APP_MASTER_KEY=                        # Fernet key: encrypts Telethon sessions + bot tokens at rest
APP_MASTER_KEY_PREV=                   # optional previous key during rotation
SESSION_SECRET=                        # signs auth cookies

# ---- Telegram ----
TG_API_ID=                             # from https://my.telegram.org
TG_API_HASH=
PLATFORM_BOT_TOKEN=                    # bot used for admin login + platform alerts
ADMIN_TG_IDS=                          # comma-separated Telegram user ids allowed into /admin

# ---- AI providers ----
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ---- Budgets / limits ----
DEFAULT_DAILY_CHAT_BUDGET_USD=5
DEFAULT_DAILY_STUDIO_BUDGET_USD=20
PLATFORM_DAILY_LLM_CAP_USD=200
MEDIA_MAX_BYTES=209715200              # 200 MB

# ---- Datastores ----
POSTGRES_USER=kanalchi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kanalchi
MINIO_ROOT_USER=kanalchi
MINIO_ROOT_PASSWORD=change-me-too

# ---- Misc ----
LOG_LEVEL=INFO
SENTRY_DSN=
