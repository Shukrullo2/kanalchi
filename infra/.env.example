# ---- Environment ----
APP_ENV=prod                          # prod disables dev-login, requires APP_MASTER_KEY, sets Secure cookies
LOG_LEVEL=INFO
SENTRY_DSN=

# ---- Domains ----
ADMIN_HOST=admin.example.com          # central admin panel host (DNS A record -> PUBLIC_IP)
PLATFORM_DOMAIN=example.com           # channels without a domain of their own live at <slug>.PLATFORM_DOMAIN (wildcard A record)
PUBLIC_IP=203.0.113.10                # VPS public IP (tenant DNS must point here)
PUBLIC_SCHEME=https
CONTACT_URL=https://t.me/your_username   # landing page (PLATFORM_DOMAIN itself): where "questions" and payment contact go
ACME_EMAIL=ops@example.com

# ---- App secrets (generate: `make gen-keys`) ----
APP_MASTER_KEY=                        # Fernet key: encrypts Telethon sessions + bot tokens at rest
APP_MASTER_KEY_PREV=                   # optional previous key during rotation
SESSION_SECRET=                        # signs auth cookies

# ---- Telegram ----
TG_API_ID=                             # from https://my.telegram.org
TG_API_HASH=
PLATFORM_BOT_TOKEN=                    # bot used for admin login + platform alerts
ADMIN_TG_IDS=                          # comma-separated Telegram user ids allowed into /admin

# ---- AI providers ----
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ---- Plans / billing (USD; the admin collects payment by hand and marks it in /admin) ----
PLAN_ARCHIVE_USD=9                     # imported history as a site, no updates
PLAN_BASIC_USD=19                      # archive + live updates
PLAN_PREMIUM_USD=39                    # basic + the studio's writing tools (AI usage billed separately)
ONBOARDING_BASE_USD=5                  # one-off import price = base + estimated AI cost x markup, never below the floor
ONBOARDING_AI_MARKUP=2
ONBOARDING_MIN_USD=10

# ---- Budgets / limits ----
DEFAULT_DAILY_CHAT_BUDGET_USD=5
DEFAULT_DAILY_STUDIO_BUDGET_USD=20
PLATFORM_DAILY_LLM_CAP_USD=200
MEDIA_MAX_BYTES=209715200              # 200 MB
MEDIA_SKIP_KINDS=                      # e.g. "video": keep a thumbnail and link to Telegram instead of storing

# ---- Datastores ----
POSTGRES_USER=kanalchi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kanalchi
MINIO_ROOT_USER=kanalchi
MINIO_ROOT_PASSWORD=change-me-too
